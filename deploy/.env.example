# 배포 값. 이 파일을 .env 로 복사해서 채운다 (.env 는 git에 올리지 않음).
# 무작위 값 만들기:  openssl rand -hex 32

# --- 주소 ---------------------------------------------------------------
# API 도메인. 도메인이 없으면 서버 공인 IP로 sslip.io (점을 -로): 152-67-1-2.sslip.io
API_DOMAIN=
# 프론트 주소 (쉼표로 여러 개). 예: https://kingsejong.vercel.app,http://localhost:5173
CORS_ALLOWED_ORIGINS=

# --- DB -----------------------------------------------------------------
DB_NAME=kingsejong
DB_USER=kingsejong
DB_PASSWORD=

# --- 서버 ---------------------------------------------------------------
# 로그인 토큰 서명 키 (32바이트 이상). 바꾸면 모든 사용자가 다시 로그인
JWT_SECRET=
# 관리자 주소(/api/v1/admin/**)의 X-Admin-Key (32자 이상 무작위 권장)
ADMIN_KEY=
# 메모리가 1GB인 작은 서버면 -Xmx384m 처럼 줄인다
# JAVA_OPTS=-XX:MaxRAMPercentage=70 -XX:+ExitOnOutOfMemoryError

# --- 교정 엔진 ----------------------------------------------------------
# 엔진 레포 위치 (deploy 폴더 기준). 서버 레포 옆에 클론했으면 그대로
ENGINE_SRC=../../Python-correction-engine
ENGINE_VERSION=0.3.0
ENGINE_WORKERS=2
# 킹세종 말풍선(LLM). 없으면 정해 둔 문장으로 나감
GEMINI_API_KEY=
